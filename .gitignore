.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# env
.env

# credenciales locales de prueba (nunca al repo)
credentials.md

# Archivos internos del CLI de Supabase
supabase/.temp/

# Temporales del video promocional (se regeneran con store/play/video/componer_video.py)
/store/play/video/tmp/
# Grabaciones crudas del video (pesadas; viven solo en local)
/store/play/video/fuente/
# Pista de música en WAV (12 MB; se regenera igual con store/play/video/musica.py)
/store/play/video/musica.wav

# Builds de Android (pesados; se descargan de EAS)
*.aab
*.apk
